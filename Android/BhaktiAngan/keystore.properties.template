# Bhakti Angan — release signing (UPLOAD key for Play App Signing).
#
# 1. Create the upload keystore ONCE (you choose the passwords; keep them safe):
#      keytool -genkeypair -v -keystore bhaktiangan-upload.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2. Copy this file to "keystore.properties" (already gitignored) and fill in below.
# 3. Put bhaktiangan-upload.jks in this folder (Android/BhaktiAngan/). It is gitignored.
#
# Do NOT commit keystore.properties or the .jks. Losing them means you cannot ship
# updates under the same upload key (recoverable via Play support, but avoid it).

storeFile=bhaktiangan-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
